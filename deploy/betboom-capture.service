# systemd unit for the BetBoom capture.
#
# Paths are placeholders: vps-setup.sh prints the sed command that fills them,
# or edit __ROOT__ and __USER__ by hand.
#
# Not exercised in this repository's tests -- the capture itself is, the unit
# file is not. Exercised live on 22.09.2026 on the capture host (Ubuntu 26.04):
# active, reporting ok. What it encodes is the operational intent: restart on failure,
# never give up permanently, and take the whole machine's uptime rather than a
# login session's.

[Unit]
Description=BetBoom live odds capture
After=network-online.target
Wants=network-online.target
# No cap on restarts, ever: this pairs with Restart=always below. The setting
# belongs to [Unit]; in [Service] it is a deprecated alias at best.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
# Under systemd stdout is a pipe, and Python would hold its output in a block
# buffer for minutes; the journal must show each line as it is printed.
Environment=PYTHONUNBUFFERED=1
ExecStart=__ROOT__/.venv/bin/python -m tennis.ingest.betboom.client --out data/raw --max-matches 10

# The recorder reconnects on its own with a growing backoff, so a restart here
# means it died outright. Always come back; a capture that stays down is the
# one failure that costs data permanently, since a game market is gone a minute
# after it is quoted.
Restart=always
RestartSec=10

# Heartbeats and the exit report go to the journal: journalctl -u betboom-capture
StandardOutput=journal
StandardError=journal

# The process only writes under data/ in its own working directory. That
# directory must exist before the first start: systemd refuses to start a unit
# whose ReadWritePaths= is missing (status=226/NAMESPACE). vps-setup.sh
# creates it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__ROOT__/data

[Install]
WantedBy=multi-user.target
